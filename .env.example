# Load order: parent folder `.env` first, then this file overrides (see README).
# Teaching staff keys (exact names): PORTKEY_API_KEY and/or OPENAI_API_KEY

PORTKEY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-6-luna
SEARCH_API_KEY=
SEARCH_PROVIDER=
APP_MODE=demo
# Model calls. If empty, LLM_MODE follows APP_MODE.
# Email, purchases, and insurers stay simulated even when LLM_MODE=live.
LLM_MODE=demo
INTEGRATION_MODE=simulated
MAX_AGENT_CALLS=25
MAX_WORKFLOW_COST_USD=2.00